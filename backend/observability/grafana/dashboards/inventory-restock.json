{
  "id": null,
  "uid": "inventory-restock",
  "title": "Inventory restock",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "stock_consumption_total",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "stock_consumption_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "restock_events_total",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "restock_events_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "notifications_sent_total",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "notifications_sent_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "notifications_failed_total",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "notifications_failed_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM memory used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_used_bytes", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP server requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "http_server_requests_seconds_count", "refId": "A" }]
    }
  ]
}
